<section class="ee-section ee-stats reveal-up">
  <div class="ee-container">
    <div class="ee-stats-grid">
      <article class="ee-card ee-stat-card">
        <strong class="ee-stat-number">{{ store.products_count ?: '6+' }}</strong>
        <p>{{ trans('theme.stat_books') }}</p>
      </article>
      <article class="ee-card ee-stat-card">
        <strong class="ee-stat-number">1000+</strong>
        <p>{{ trans('theme.stat_vocab') }}</p>
      </article>
      <article class="ee-card ee-stat-card">
        <strong class="ee-stat-number">700+</strong>
        <p>{{ trans('theme.stat_phrases') }}</p>
      </article>
      <article class="ee-card ee-stat-card">
        <strong class="ee-stat-number">A1-C2</strong>
        <p>{{ trans('theme.stat_levels') }}</p>
      </article>
    </div>
  </div>
</section>
