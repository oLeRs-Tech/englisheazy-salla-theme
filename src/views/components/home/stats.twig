<section class="ee-section ee-stats reveal-up">
  <div class="ee-container">
    <div class="ee-stats-grid">
      <article class="ee-card ee-stat-card">
        <strong class="ee-stat-number">{{ component.stat_books_value ?: '6' }}</strong>
        <p>{{ component.stat_books_label ?: trans('theme.stat_books') }}</p>
      </article>
      <article class="ee-card ee-stat-card">
        <strong class="ee-stat-number">{{ component.stat_vocab_value ?: '1000+' }}</strong>
        <p>{{ component.stat_vocab_label ?: trans('theme.stat_vocab') }}</p>
      </article>
      <article class="ee-card ee-stat-card">
        <strong class="ee-stat-number">{{ component.stat_phrases_value ?: '700+' }}</strong>
        <p>{{ component.stat_phrases_label ?: trans('theme.stat_phrases') }}</p>
      </article>
      <article class="ee-card ee-stat-card">
        <strong class="ee-stat-number">{{ component.stat_levels_value ?: 'A1-C2' }}</strong>
        <p>{{ component.stat_levels_label ?: trans('theme.stat_levels') }}</p>
      </article>
    </div>
  </div>
</section>
