    },
    {
      "type": "string",
      "label": "Hero subtitle",
      "id": "hero_subtitle",
      "format": "textarea",
      "value": "Practical books, interactive tests, and a clear path to real progress."
    },
    {
      "type": "string",
      "label": "Primary button text",
      "id": "hero_primary_cta_text",
      "format": "text",
      "value": "Start now"
    },
    {
      "type": "string",
      "label": "Secondary button text",
      "id": "hero_secondary_cta_text",
      "format": "text",
      "value": "Browse books"
    },
    {
      "type": "string",
      "label": "Package section title",
      "id": "package_title",
      "format": "text",
      "value": "The Z Package"
    },
    {
      "type": "string",
      "label": "Package section subtitle",
      "id": "package_subtitle",
      "format": "textarea",
      "value": "A complete 6-book system that covers all core English skills."
    },
    {
      "type": "string",
      "label": "Package price",
      "id": "package_price",
      "format": "text",
      "value": "149"
    }
