    {
      "name": "home.hero",
      "path": "src/views/components/home/hero.twig"
    },
    {
      "name": "home.stats",
      "path": "src/views/components/home/stats.twig"
    },
    {
      "name": "home.package",
      "path": "src/views/components/home/package.twig"
    },
    {
      "name": "home.books",
      "path": "src/views/components/home/books.twig"
    }
  ]
}
